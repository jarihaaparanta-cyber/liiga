---
import Sivupohja from '../layouts/Sivupohja.astro';
import SivuHero from '../components/SivuHero.astro';
import Galleria from '../components/Galleria.astro';
import Tarjous from '../components/Tarjous.astro';
import sininen from '../assets/kuvat/Galleria_sininen.webp';
import putket from '../assets/kuvat/FromCom_4.webp';
import novatron from '../assets/kuvat/IMG-20220524-WA0005.webp';
import ranta from '../assets/kuvat/IMG_20220711_221224963_HDR.webp';
import tyomaa from '../assets/kuvat/FromCom_2.webp';
import piha from '../assets/kuvat/valmis1-1.webp';
import perustus from '../assets/kuvat/IMG-20210724-WA0005.webp';
import kaivu from '../assets/kuvat/FromCom_1.webp';
import raivaus from '../assets/kuvat/IMG_20220818_181338203.webp';
import purku from '../assets/kuvat/Purku5.webp';
import tiivistys from '../assets/kuvat/IMG_20220428_174220470.jpg';
import kobelco from '../assets/kuvat/Fromcom_hero.webp';

// TÄYDENNETÄÄN: referenssikohteiden tarkemmat kuvaukset (paikkakunta, työn sisältö, vuosi) asiakkaalta.
const kuvat = [
  { kuva: sininen, alt: 'FromComin turkoosi kaivinkone metsäisellä maanrakennustyömaalla', otsikko: 'Kalustoa työmaalla', tunniste: 'FROMCOM OY / KALUSTO' },
  { kuva: putket, alt: 'Putkitus ja sorapohja työmaalla', otsikko: 'Vesi- ja viemärityöt', tunniste: 'FROMCOM OY / MAANRAKENNUS' },
  { kuva: novatron, alt: 'Novatron-koneohjauksen näyttö kaivinkoneen ohjaamossa', otsikko: 'Koneohjaus työssä', tunniste: 'NOVATRON / 3D-KONEOHJAUS' },
  { kuva: ranta, alt: 'Rakennuksen perustukset rantamaisemassa', otsikko: 'Rakennusten perustustyöt', tunniste: 'FROMCOM OY / PERUSTUKSET' },
  { kuva: tyomaa, alt: 'Maanrakennustyömaa, kaivinkone ja järvimaisema', otsikko: 'Työmaan ympäristö', tunniste: 'FROMCOM OY / TYÖMAA' },
  { kuva: piha, alt: 'Valmis nurmipiha ja rakennukset metsäisessä ympäristössä', otsikko: 'Piha- ja viherrakentaminen', tunniste: 'FROMCOM OY / PIHAT' },
  { kuva: perustus, alt: 'Rakennuksen perustukset ja sorapohja', otsikko: 'Perustukset ja sorapohja', tunniste: 'FROMCOM OY / PERUSTUKSET' },
  { kuva: tiivistys, alt: 'Oranssi kaivinkone ja työntekijä tärylevyn kanssa rakennuksen sorapohjalla', otsikko: 'Pohjan tiivistys', tunniste: 'FROMCOM OY / PERUSTUKSET' },
  { kuva: kaivu, alt: 'FromComin kaivinkone maanrakennustyömaalla', otsikko: 'Kunnallistekniset työt', tunniste: 'FROMCOM OY / MAANRAKENNUS' },
  { kuva: raivaus, alt: 'Kaivinkone raivatulla tontilla metsäisessä ympäristössä', otsikko: 'Tontin raivaus', tunniste: 'FROMCOM OY / RAIVAUS' },
  { kuva: purku, alt: 'Purkutöiden puutavaraa ja kone työmaalla', otsikko: 'Rakennuksen purku', tunniste: 'FROMCOM OY / PURKU' },
  { kuva: kobelco, alt: 'Turkoosi kaivinkone kuormaa maa-ainesta pihalla', otsikko: 'Pihan maanrakennus', tunniste: 'FROMCOM OY / PIHAT' },
];
---
<Sivupohja otsikko="Referenssit" kuvaus="Kuvia FromCom Oy:n työmailta: perustustyöt, vesi- ja viemärityöt, pihat, raivaukset ja purkutyöt Pirkanmaalla.">
  <SivuHero
    kuva={ranta}
    kuvaAlt="Rakennuksen perustukset rantamaisemassa"
    ylaotsikko="FROMCOM OY / REFERENSSIT"
    otsikko="Referenssit"
    ingressi="Koneita, työmaita ja toteutuksia FromComin omista kohteista eri puolilta Pirkanmaata."
    murupolku={[{ nimi: 'Referenssit' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">01 / KUVAGALLERIA</span>
        <h2>Työmailta</h2>
        <p>Avaa kuva suuremmaksi napauttamalla. Kuvia voi selata nuolilla.</p>
      </div>
      <Galleria kuvat={kuvat} />
    </div>
  </section>

  <Tarjous otsikko="Seuraava kohde voi olla sinun." />
</Sivupohja>

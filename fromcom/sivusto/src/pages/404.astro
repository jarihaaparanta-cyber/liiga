  <SivuHero kompakti ylaotsikko="404" otsikko="Sivua ei löytynyt." ingressi="Etsimääsi sivua ei ole tai se on siirretty." murupolku={[{ nimi: '404' }]}>
    <div class="buttons"><a class="button button-light" href="/">Etusivulle <Ikoni nimi="nuoli" /></a><a class="button button-outline" href="/palvelut/">Palvelut <Ikoni nimi="nuoli" /></a></div>
  </SivuHero>
</Sivupohja>
